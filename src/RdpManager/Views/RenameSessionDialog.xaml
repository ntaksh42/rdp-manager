<Window x:Class="RdpManager.Views.RenameSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Session" SizeToContent="Height" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" UseLayoutRounding="True"
        Background="{DynamicResource WindowBg}"
        TextElement.Foreground="{DynamicResource TextFg}">
    <StackPanel Margin="14">
        <TextBlock Text="Tab name:" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,14" KeyDown="OnNameBoxKeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="90" Padding="0,4" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
            <Button Content="Cancel" Width="90" Padding="0,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
