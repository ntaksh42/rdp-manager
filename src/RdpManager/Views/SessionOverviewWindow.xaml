<Window x:Class="RdpManager.Views.SessionOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Overview"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBg}"
        TextElement.Foreground="{DynamicResource TextFg}"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated"
        Loaded="OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="KeyHint" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="12,0,5,0"/>
        </Style>

        <!-- 番号バッジ（1〜9 でジャンプ可能なタイルのみ表示）-->
        <DataTemplate x:Key="NumberBadge">
            <Border MinWidth="20" Height="20" CornerRadius="3" Margin="0,0,8,0" Padding="4,0"
                    Visibility="{Binding HasNumber, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ControlBorder}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBg}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <!-- リモート画面（スナップショット＋状態オーバーレイ）。グリッド/スポットライト/リストで共通 -->
        <DataTemplate x:Key="ScreenTemplate">
            <Grid Background="{DynamicResource BarBg}" ClipToBounds="True">
                <TextBlock Text="No preview yet" Foreground="{DynamicResource SubtleFg}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}"/>
                <Image Source="{Binding Image}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- 切断中は画面を暗くして再接続できることを示す -->
                <Grid Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource WindowBg}" Opacity="0.7"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Disconnected" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Enter to reconnect" FontSize="12" Foreground="{DynamicResource SubtleFg}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource WindowBg}" CornerRadius="3" Padding="8,2"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 選択・ホバーで枠と背景を強調するタイル枠 -->
        <Style x:Key="TileFrame" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
        <DockPanel>
            <!-- ヘッダ: 件数・絞り込み・キー操作ヒント -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource BarBg}"
                    BorderBrush="{DynamicResource SplitterBg}" BorderThickness="0,0,0,1" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Sessions" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource ControlBorder}" CornerRadius="9" Padding="8,1" Margin="8,0,16,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CountText" FontSize="12"/>
                        </Border>
                        <Grid Width="280" VerticalAlignment="Center">
                            <TextBox x:Name="FilterBox" Padding="6,4" TextChanged="OnFilterChanged"/>
                            <TextBlock Text="Type to filter…" Foreground="{DynamicResource SubtleFg}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Right" TextElement.FontSize="12">
                        <Border Style="{StaticResource KeyHint}"><TextBlock Text="Arrows"/></Border>
                        <TextBlock Text="Move" Foreground="{DynamicResource SubtleFg}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource KeyHint}"><TextBlock Text="Enter"/></Border>
                        <TextBlock Text="Switch" Foreground="{DynamicResource SubtleFg}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource KeyHint}"><TextBlock Text="Space"/></Border>
                        <TextBlock x:Name="SpaceHintText" Text="Enlarge" Foreground="{DynamicResource SubtleFg}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource KeyHint}"><TextBlock Text="1–9"/></Border>
                        <TextBlock Text="Jump" Foreground="{DynamicResource SubtleFg}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource KeyHint}"><TextBlock Text="Esc"/></Border>
                        <TextBlock Text="Close" Foreground="{DynamicResource SubtleFg}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <TextBlock x:Name="NoMatchText" Text="No sessions match the filter."
                           Foreground="{DynamicResource SubtleFg}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- グリッド表示: 件数と領域からタイルが最大になる列数で並べる -->
                <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="8" SizeChanged="OnGridAreaSizeChanged">
                    <ItemsControl x:Name="GridItems" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding GridColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TileFrame}" Margin="8"
                                        Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        MouseLeftButtonUp="OnTileClick">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Bottom" Margin="2,6,2,0" Height="22">
                                            <ContentPresenter DockPanel.Dock="Left" Content="{Binding}"
                                                              ContentTemplate="{StaticResource NumberBadge}"/>
                                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0"
                                                     Fill="{Binding StateColor}" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" FontSize="12"
                                                       Foreground="{DynamicResource SubtleFg}" VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="13"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="{Binding TitleMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <TextBlock Text="{Binding Host}" FontSize="13" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource SubtleFg}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ScreenTemplate}"
                                                          Height="{Binding ScreenHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- スポットライト表示（Space）: 選択中を大きく、他は右に縦並び -->
                <Grid x:Name="SpotlightPanel" Visibility="Collapsed" Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel x:Name="SpotlightMain" Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="2,10,2,0">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NumberBadge}"
                                              VerticalAlignment="Center"/>
                            <Ellipse Width="10" Height="10" Margin="0,0,10,0" Fill="{Binding StateColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Detail}" FontSize="14" Margin="12,0,0,0"
                                       Foreground="{DynamicResource SubtleFg}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource AccentBg}" BorderThickness="2" CornerRadius="4">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ScreenTemplate}"/>
                        </Border>
                    </DockPanel>
                    <ScrollViewer x:Name="SpotlightScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="SpotlightItems" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TileFrame}" Margin="0,0,0,6" Padding="5"
                                            MouseLeftButtonUp="OnTileClick">
                                        <DockPanel>
                                            <ContentPresenter DockPanel.Dock="Left" Width="128" Height="72"
                                                              Content="{Binding}" ContentTemplate="{StaticResource ScreenTemplate}"/>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NumberBadge}"/>
                                                    <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Host}" FontSize="12" Foreground="{DynamicResource SubtleFg}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
